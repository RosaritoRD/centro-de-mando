# tu empresa — APM · variables de entorno
#
# Copiar a `.env` y rellenar. El `.env` NUNCA va al repo (ver .gitignore).
# Los valores de Firebase son los MISMOS que usa tu web principal: APM no tiene
# login propio, reusa la cookie SSO `__session` del dominio padre.

# ── Base de datos ──────────────────────────────────────────────────
# BD propia dentro del Postgres existente (contenedor n8n_postgres).
# El host es el nombre del contenedor porque APM vive en la red n8n_internal.
APM_DB_URL=postgres://apm_app:CAMBIAME@n8n_postgres:5432/apm

# ── Anthropic ──────────────────────────────────────────────────────
# ⚠️ NO existe todavía. Hace falta para la Fase 2 (runtime de agentes);
# la Fase 1 arranca sin ella.
ANTHROPIC_API_KEY=

# ── Firebase (SSO) — mismo proyecto que tu web principal ─────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada va entre comillas y con los \n literales, igual que en tu web principal.
FIREBASE_PRIVATE_KEY=

# ── Aplicación ─────────────────────────────────────────────────────
APP_BASE_URL=https://apm.tu-dominio.com
# Adónde se manda a quien no tiene sesión válida.
SIGNIN_URL=https://signin.tu-dominio.com

# Allowlist de UIDs de Firebase, separados por coma. APM es de UN usuario:
# cualquier UID válido que no esté aquí recibe 403, no una página vacía.
# Que un empleado de un DSP con cuenta en tu-dominio.com pudiera entrar al
# centro de mando sería el fallo más caro posible.
APM_ALLOWED_UIDS=

# ── Topes operativos (ver docs/ARCHITECTURE.md §8) ─────────────────
# ~1 GiB por agente sobre 4,6 GB libres. No es una sugerencia.
MAX_CONCURRENT_RUNS=2
# Freno de mano del multiplicador 15x del multi-agente.
DAILY_BUDGET_USD=5

# ── n8n ────────────────────────────────────────────────────────────
# La REST API sirve para MONITOREAR; para disparar se usan los webhooks.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=

# ── Docker ─────────────────────────────────────────────────────────
# Red donde vive Nginx Proxy Manager. Detectada en esta VPS.
PROXY_NETWORK=nginx-proxy-manager_default
