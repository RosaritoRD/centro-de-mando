# Command Center — environment variables
#
# Copy to `.env` and fill in. The `.env` file NEVER goes into the repo (see .gitignore).
# The Firebase values are the SAME ones your main website uses: the dashboard has no
# login of its own, it reuses the `__session` SSO cookie from the parent domain.

# ── Database ───────────────────────────────────────────────────────
# Its own database inside an existing Postgres.
# The host is the container name because the app lives on the same Docker network.
APM_DB_URL=postgres://apm_app:CHANGE_ME@n8n_postgres:5432/apm

# ── Anthropic ──────────────────────────────────────────────────────
# Required for the agent runtime.
ANTHROPIC_API_KEY=

# ── Firebase (SSO) — same project as your main website ────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# The private key goes in quotes with literal \n, same as in your main website.
FIREBASE_PRIVATE_KEY=

# ── Application ────────────────────────────────────────────────────
APP_BASE_URL=https://apm.your-domain.com
# Where anyone without a valid session gets sent.
SIGNIN_URL=https://signin.your-domain.com

# Allow-list of Firebase UIDs, comma-separated. This is a SINGLE-user dashboard:
# any valid UID that isn't listed here gets a 403, not an empty page.
# Letting any other account on your domain into the command center would be the
# most expensive mistake possible.
APM_ALLOWED_UIDS=

# ── Operating caps (see docs/ARCHITECTURE.md §8) ───────────────────
# ~1 GiB per agent. Size it to your free RAM; this isn't a suggestion.
MAX_CONCURRENT_RUNS=2
# Handbrake for the ~15x multi-agent cost multiplier.
DAILY_BUDGET_USD=5

# ── n8n ────────────────────────────────────────────────────────────
# The REST API is for MONITORING; triggering uses webhooks.
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=

# ── Docker ─────────────────────────────────────────────────────────
# Network where your reverse proxy (e.g. Nginx Proxy Manager) lives.
PROXY_NETWORK=nginx-proxy-manager_default
